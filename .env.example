# AI Model Configuration
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# For MODEL_PROVIDER=api:
# API_BASE_URL=
# API_KEY=

# Meta/Instagram Graph API (optional)
# META_GRAPH_TOKEN=
# META_IG_USER_ID=

# Google Sheets Integration (ONE-WAY: CSV -> Google Sheets)
# Get credentials from: Google Cloud Console > APIs & Services > Credentials
# Create OAuth Client ID -> Desktop app, download credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=
GOOGLE_SHEETS_RANGE=

# Note: .env is gitignored and contains actual secret values