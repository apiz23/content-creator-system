# AI Model Configuration
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# For MODEL_PROVIDER=api:
# API_BASE_URL=
# API_KEY=

# Meta/Instagram Graph API (optional)
# META_GRAPH_TOKEN=
# META_IG_USER_ID=

# Google Sheets Integration (ONE-WAY: CSV -> Google Sheets)
# The new system uses the existing Hermes google_api.py wrapper.
# No credentials.json or token.json are stored in this repository.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Creator Intel
GOOGLE_SHEETS_RANGE='Creator Intel'!A:S

# Optional: when Hermes is installed in a non-standard location.
# On the supervisor's Mac Mini, these point to the existing Hermes:
# HERMES_GOOGLE_API_PYTHON=/Users/Kidd-Agent/.hermes/gws-venv/bin/python
# HERMES_GOOGLE_API_SCRIPT=/Users/Kidd-Agent/.hermes/skills/productivity/google-workspace/scripts/google_api.py
#
# If not set, the current Python interpreter and the default
# Hermes path (~/.hermes/skills/productivity/google-workspace/scripts/google_api.py) are used.

# Note: .env is gitignored and contains actual secret values