# AI Model Configuration
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# For MODEL_PROVIDER=api:
# API_BASE_URL=
# API_KEY=

# Meta/Instagram Graph API (optional)
# META_GRAPH_TOKEN=
# META_IG_USER_ID=

# Google Sheets Sync (optional)
# Set GOOGLE_SHEETS_ENABLED=true to sync merged CRM rows to Google Sheets
# Requires Service Account JSON credentials (NOT a plain API key — API keys are read-only)
# Generate credentials: Google Cloud Console → APIs & Services → Service Accounts → Create Key
# Share the Google Sheet with the service account email address
# GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEETS_CREDENTIALS_PATH=
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB=CRM

# Note: .env is gitignored and contains actual secret values
